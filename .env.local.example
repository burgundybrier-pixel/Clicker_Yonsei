# Supabase 프로젝트 설정 > API 메뉴에서 값을 복사해 .env.local 파일을 만드세요.
# .env.local 은 .gitignore에 포함되어 커밋되지 않습니다.

# 클라이언트(브라우저)에서도 사용됨 — departments 테이블 조회 전용(RLS로 SELECT만 허용)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 서버 전용(app/api/* 라우트에서만 사용) — 절대 NEXT_PUBLIC_ 접두사를 붙이지 말 것.
# support_department / attack_department RPC 호출과 요청 빈도 제한을 통과한
# 점수 변경만 이 키로 DB에 반영된다.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
