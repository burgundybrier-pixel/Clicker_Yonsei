# ─────────────────────────────────────────────────────────────────────────────
# 이 파일을 복사해서 .env.local 을 만들고 값을 채우세요.  (.env.local 은 git 에 올라가지 않습니다)
#   Windows PowerShell:  copy .env.local.example .env.local
#   macOS / Linux:       cp .env.local.example .env.local
#
# 값을 채우지 않아도 앱은 "개발 모드"로 동작합니다 (lib/devStore.ts 의 메모리 DB 사용, 재시작 시 점수 초기화).
# 실제 Supabase 연결 방법은 docs/SUPABASE_SETUP.md 를 보세요.
# 값을 바꾼 뒤에는 `npm run dev` 를 반드시 재시작해야 반영됩니다.
# ─────────────────────────────────────────────────────────────────────────────

# [공개 가능] 브라우저에도 실려 나갑니다. Supabase 대시보드 → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# [공개 가능] 같은 화면의 "anon public" 키. RLS 정책 때문에 departments 테이블을 읽기만 할 수 있습니다.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# [절대 비공개] 같은 화면의 "service_role" 키. 모든 보안 규칙을 우회하는 관리자 키입니다.
#   - 앞에 NEXT_PUBLIC_ 을 붙이면 브라우저로 새어 나가니 절대 붙이지 마세요.
#   - app/api/** (서버) 에서만 사용됩니다. lib/server/supabaseAdmin.ts 참고.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
